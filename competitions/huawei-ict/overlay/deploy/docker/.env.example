# 智研本地部署配置模板。
#
# 不要手工复制为 .env：运行 ./start.sh 或 python3 generate_secrets.py，
# 它会复制本文件并把下面三个空白的系统密钥填上随机值，权限设为 0600。
#
# 本文件可以进版本库，生成出的 .env 不可以（.gitignore 已覆盖 **/.env）。

# ───────────────────────── 系统密钥（由 generate_secrets.py 生成，留空）
# Flask 会话签名。
SECRET_KEY=
# 模型凭据的 AES-GCM 主密钥：URL-safe Base64，解码后必须 32 字节。
# 更换此值会使数据库中已存的模型密钥全部无法解密。
MODEL_CONFIG_ENCRYPTION_KEY=
# 本机数据库口令；端口只发布到 127.0.0.1。
POSTGRES_PASSWORD=

# ───────────────────────── 端口与库名
WEB_PORT=18080
POSTGRES_DB=zhiyan
POSTGRES_USER=zhiyan
POSTGRES_PORT=55432
REDIS_PORT=56379

# ───────────────────────── 模型接入
# 标准模型为 DeepSeek 官方接口。模型库页面同时支持通义千问、智谱 GLM
# 和任意 OpenAI 兼容网关，用户可自行切换。
USER_API_MODEL_BASE_URL=https://api.deepseek.com
USER_API_MODEL_NAME=deepseek-flash
USER_API_MODEL_TIMEOUT_SECONDS=120
USER_API_MODEL_MAX_OUTPUT_TOKENS=3072

# 以下三个 API Key 留空即可：每位用户在「个人中心 / 模型库」填写自己的密钥。
# 只有需要给全站配置一个默认密钥时才填，填入后会产生真实调用费用。
USER_API_MODEL_API_KEY=
TRANSLATION_API_KEY=
CHUNK_QA_MODEL_API_KEY=

# 学术翻译与知识库问答生成默认复用同一接口。
TRANSLATION_LLM_BACKEND=api
TRANSLATION_API_BASE_URL=https://api.deepseek.com
TRANSLATION_API_MODEL=deepseek-flash
CHUNK_QA_MODEL_BASE_URL=https://api.deepseek.com
CHUNK_QA_MODEL_NAME=deepseek-flash

# ───────────────────────── 自研微调模型（本版本不部署）
# 27B 微调模型对显存要求过高，不随本部署包启动，接口保留。
# 另行部署好之后把 PLATFORM_MODEL_ENABLED 改为 true 并填写下面三项即可启用，
# 界面上的「平台通用模型」会随之出现。
PLATFORM_MODEL_ENABLED=false
QWEN_DPO_BASE_URL=
QWEN_DPO_MODEL=
QWEN_DPO_API_KEY=
QWEN_DPO_TIMEOUT_SECONDS=180

# ───────────────────────── 重型运行时（构建期开关）
# 置为 false 可跳过对应运行时的构建，相关功能会明确报告“未部署”，
# 而不是在调用时报错。公式识别运行时约 1.8G，构建耗时最长。
INSTALL_FORMULA_RUNTIME=true
INSTALL_PPT_RUNTIME=true
FORMULA_RECOGNITION_CPU_THREADS=2

# ───────────────────────── 知识库检索
# 向量与重排使用硅基流动 API；请自行填写密钥，需另外准备索引服务。
# 本机示例默认不启用检索索引，关闭时不代表完整检索可用。
KB_MILVUS_ENABLED=0
ELASTICSEARCH_ENABLED=0
KB_EMBEDDING_BACKEND=api
KB_EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
KB_EMBEDDING_API_MODEL=BAAI/bge-m3
KB_EMBEDDING_API_KEY=
KB_RERANKER_BACKEND=api
KB_RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
KB_RERANKER_API_MODEL=BAAI/bge-reranker-v2-m3
KB_RERANKER_API_KEY=

# ───────────────────────── 短信
# 注册与验证码登录需要短信服务商；disabled 时用手机号+密码登录。
SMS_PROVIDER=disabled

# ───────────────────────── 普通用户免费额度（token）
NORMAL_USER_FREE_TOKEN_QUOTA=1000000

# ───────────────────────── Gunicorn
# 单 worker 是硬性要求：任务线程与内嵌知识库不支持多进程。
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=3600
