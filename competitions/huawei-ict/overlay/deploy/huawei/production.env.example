# 复制为 .env.production 并设置权限 0600；不要提交真实值。
SECRET_KEY=
MODEL_CONFIG_ENCRYPTION_KEY=
# 访问地址：有已备案域名和证书后再填写，例如 https://zhiyan.example.com
PUBLIC_ORIGIN=

# 华为云 RDS for PostgreSQL（需 18 版本，数据库用 C 排序规则创建，见生产部署说明）
# POSTGRES_HOST 填实例的内网地址；账号需要对该数据库有建表权限。
POSTGRES_HOST=
POSTGRES_SERVER_PORT=5432
POSTGRES_DB=zhiyan
POSTGRES_USER=zhiyan
POSTGRES_PASSWORD=

# 华为云 DCS Redis，内网地址。有密码时写成 redis://:密码@地址:6379/0
# （密码中的特殊字符需要做 URL 编码）。
REDIS_URL=
PLATFORM_MODEL_ENABLED=false
QWEN_DPO_BASE_URL=
QWEN_DPO_MODEL=
QWEN_DPO_API_KEY=
USER_API_MODEL_BASE_URL=https://api.deepseek.com
USER_API_MODEL_NAME=deepseek-flash
USER_API_MODEL_API_KEY=
TRANSLATION_LLM_BACKEND=api
TRANSLATION_API_BASE_URL=https://api.deepseek.com
TRANSLATION_API_MODEL=deepseek-flash
TRANSLATION_API_KEY=
CHUNK_QA_MODEL_BASE_URL=https://api.deepseek.com
CHUNK_QA_MODEL_NAME=deepseek-flash
CHUNK_QA_MODEL_API_KEY=
KB_MILVUS_ENABLED=1
KB_MILVUS_URI=/data/knowledge-base/milvus_lite.db
KB_MILVUS_COLLECTION=paper_chunks_bge_m3
KB_MILVUS_DIM=1024
ELASTICSEARCH_ENABLED=1
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT=
KB_EMBEDDING_BACKEND=api
KB_EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
KB_EMBEDDING_API_MODEL=BAAI/bge-m3
KB_EMBEDDING_API_KEY=
KB_RERANKER_BACKEND=api
KB_RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
KB_RERANKER_API_MODEL=BAAI/bge-reranker-v2-m3
KB_RERANKER_API_KEY=
SMS_PROVIDER=disabled
# UniMERNet runs locally on CPU for formula recognition.
INSTALL_FORMULA_RUNTIME=true
INSTALL_PPT_RUNTIME=true
